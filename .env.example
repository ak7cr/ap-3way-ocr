# FastAPI backend runs on :8000 (uvicorn). Vite proxies /api -> :8000.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/order_ocr
# Tables (invoice_templates, extraction_logs, extraction_reviews) are created
# automatically on backend startup.

# Primary AI vision provider (used when the local OCR engine output is weak).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Backup AI vision provider, used when Claude is unavailable or fails.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ── Extraction escalation thresholds (Step 0) ────────────────────────────────
# Confidence bands; override here and every log line records which band fired.
ESCALATION_AUTO_ACCEPT=0.98
ESCALATION_REVIEW_FLOOR=0.70
ESCALATION_TEMPLATE_MATCH=0.85
ESCALATION_AI_ACCEPT=0.85
ESCALATION_LOW_FIELD=0.70
ESCALATION_QUARANTINE_RATE=0.25
ESCALATION_QUARANTINE_MIN_RUNS=5

# ── Scanned-image OCR routing ────────────────────────────────────────────────
# Scanned images are routed to these engines (they score 2/40 on the AP sample
# kit versus 0/40 for this repo's own engine); digital PDFs stay local, where
# this repo scores 25/40 versus 9/40. Start them with `npm run dev:ocr`.
EXTERNAL_OCR_ENABLED=true
EXTERNAL_OCR_SERVICES=c++=http://127.0.0.1:8021,line-system=http://127.0.0.1:8022
EXTERNAL_OCR_TIMEOUT=180
EXTERNAL_OCR_HEALTH_TIMEOUT=2
EXTERNAL_OCR_PIPELINE_MODE=local

# ── Validation gate (arithmetic + format checks, not OCR confidence) ─────────
# Only documents that pass these checks are allowed into matching.
VALIDATION_LINE_SUM_ABS=2.00
VALIDATION_TAX_ABS=2.00
VALIDATION_TOTAL_ABS=2.00
VALIDATION_GSTIN_CHECKSUM=true
VALIDATION_REQUIRE_INVOICE_NUMBER=true
VALIDATION_REQUIRE_INVOICE_DATE=false
VALIDATION_REQUIRE_PO_REFERENCE=false

# ── Template trust ───────────────────────────────────────────────────────────
# A learned layout starts as CANDIDATE and becomes TRUSTED only after this many
# clean human confirmations. AI extractions never save a template on their own.
TEMPLATE_CANDIDATE_CONFIRMATIONS=3
TEMPLATE_AUTO_LEARN_LOCAL=true
TEMPLATE_AUTO_LEARN_AI=false
TEMPLATE_REQUIRE_VALIDATION=true

# ── Decision mode ────────────────────────────────────────────────────────────
# shadow: every document goes to a human while the recommendation is recorded.
# live:   auto-approve vendors that have earned it (see /api/shadow/agreement).
SHADOW_MODE=shadow
SHADOW_MIN_DECISIONS=30
SHADOW_MIN_AGREEMENT=0.95
SHADOW_ONBOARDING_VENDORS=true

# ── Tenancy + worker queue ───────────────────────────────────────────────────
TENANT_ID=default
QUEUE_MAX_ATTEMPTS=3
# WORKER_ID=ocr-worker-1

# ── 3-way match behaviour ────────────────────────────────────────────────────
MATCH_DUPLICATE_WINDOW_DAYS=180
MATCH_REQUIRE_GRN=true
# Per-vendor / per-category tolerances live in backend/config.py.

# ── Document preview / source storage (keys only are stored in Postgres) ─────
STORAGE_BACKEND=local          # local | s3 | minio
STORAGE_ROOT=./uploads
# STORAGE_BUCKET=invoice-previews
# STORAGE_ENDPOINT_URL=http://localhost:9000
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_REGION=us-east-1

# LLM assist model (advisory only: explanations, vendor emails, line suggestions)
LLM_ASSIST_MODEL=gemini-2.0-flash
